# Server-side only. Never expose this file to the frontend.
OPENAI_API_KEY=
AGENTSYNC_LLM_PROVIDER=openai
AGENTSYNC_LLM_MODEL=gpt-4o-mini
AGENTSYNC_OPENAI_API_KEY_ENV=OPENAI_API_KEY
# Optional OpenAI-compatible endpoint. Never put credentials in source control.
# OPENAI_BASE_URL=https://api.openai.com/v1
AGENTSYNC_LLM_TIMEOUT_SECONDS=25
AGENTSYNC_LLM_MAX_RETRIES=1
AGENTSYNC_MAX_TURNS=8
AGENTSYNC_SESSION_TIMEOUT_SECONDS=90
AGENTSYNC_MAX_TOOL_CALLS=6
AGENTSYNC_TOOLS_PROVIDER=mock
AGENTSYNC_MCP_SERVERS_JSON={}
# Example: {"default":{"endpoint":"https://mcp.example.com/mcp","token_env_var":"MCP_TOKEN","allowed_tools":["web.search"]}}
# First-party MCP server (run: uvicorn mcp_servers.agentsync.server:app --host 127.0.0.1 --port 8001)
AGENTSYNC_MCP_HOST=127.0.0.1
AGENTSYNC_MCP_PORT=8001
AGENTSYNC_MCP_ALLOWED_HOSTS=127.0.0.1:8001,localhost:8001
AGENTSYNC_MCP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Set this to an environment variable name (for example MCP_SERVER_TOKEN) to require Bearer auth.
# AGENTSYNC_MCP_AUTH_TOKEN_ENV=MCP_SERVER_TOKEN
AGENTSYNC_MCP_SEARCH_PROVIDER=generic
# generic provider: the endpoint receives POST {"query":"..."}.
# brave/tavily use their official API contracts; keep keys server-side.
# AGENTSYNC_MCP_SEARCH_ENDPOINT=
# AGENTSYNC_MCP_SEARCH_TOKEN_ENV=BRAVE_SEARCH_API_KEY
# AGENTSYNC_MCP_CALENDAR_ENDPOINT=
# AGENTSYNC_MCP_CALENDAR_TOKEN_ENV=CALENDAR_API_TOKEN
# AGENTSYNC_MCP_PRICES_ENDPOINT=
# AGENTSYNC_MCP_PRICES_TOKEN_ENV=PRICES_API_TOKEN
# AGENTSYNC_MCP_INVENTORY_ENDPOINT=
# AGENTSYNC_MCP_INVENTORY_TOKEN_ENV=INVENTORY_API_TOKEN
# AGENTSYNC_MCP_EMAIL_ENDPOINT=
# AGENTSYNC_MCP_EMAIL_TOKEN_ENV=EMAIL_API_TOKEN
# AGENTSYNC_MCP_MEETINGS_ENDPOINT=
# AGENTSYNC_MCP_MEETINGS_TOKEN_ENV=MEETINGS_API_TOKEN
AGENTSYNC_MCP_UPSTREAM_TIMEOUT_SECONDS=15
AGENTSYNC_MCP_UPSTREAM_MAX_RESPONSE_BYTES=1000000
AGENTSYNC_DATABASE_URL=sqlite:///agentsync.db
AGENTSYNC_USER_REQUESTS_PER_MINUTE=30
AGENTSYNC_USER_MAX_COST_USD_PER_HOUR=5.0
AGENTSYNC_USER_MAX_SESSION_SECONDS=900
AGENTSYNC_ESTIMATED_LLM_COST_USD=0.01
